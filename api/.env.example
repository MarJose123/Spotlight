# ============================================================
# Spotlight environment configuration
# Copy this file to `.env` and adjust the values as needed.
# use 'node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"' for APP_KEY
# ============================================================

# Application
NODE_ENV=development
PORT=3000
APP_KEY=

# Database driver: `postgres` (default), `mariadb` or `mysql`
DB_CONNECTION=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_DATABASE=spotlight

# S3 Compatible: Minio, Silo (Minio Fork), RustFS
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_REGION=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=

# Domains allowed to sign in, comma separated. Empty means unrestricted, which
# is only safe when the provider tenant is already restricted.
OAUTH_ALLOWED_DOMAINS=

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Callback URL should be the Web URL callback for the provider
ZOHO_CALLBACK_URL=http://localhost:5173/signin/callback
# Zoho data centre the client was registered in: .com (default), .eu, .in, .com.au, .jp, .ca, .sa
ZOHO_ACCOUNT_SERVER=https://accounts.zoho.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback URL should be the Web URL callback for the provider
GOOGLE_CALLBACK_URL=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Callback URL should be the Web URL callback for the provider
MICROSOFT_CALLBACK_URL=
MICROSOFT_TENANT_ID=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Callback URL should be the Web URL callback for the provider
GITHUB_CALLBACK_URL=
