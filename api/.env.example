# ============================================================
# Spotlight environment configuration
# Copy this file to `.env` and adjust the values as needed.
# use 'node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"' for APP_KEY
# ============================================================

# Application
NODE_ENV=development
PORT=3000
APP_KEY=

# Database driver: `postgres` (default), `mariadb` or `mysql`
DB_CONNECTION=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_DATABASE=spotlight

# S3 Compatible: Minio, Silo (Minio Fork), RustFS
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_REGION=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
