{
  "name": "spotlight-api",
  "version": "1.0.0",
  "description": "Spotlight is an internal recognition tool that helps teams celebrate and appreciate their coworkers. Employees can easily post commendations, give shout-outs, and recognize great work, helping foster a positive culture of appreciation and making achievements visible across the organization.",
  "author": "Marjose Darang",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.ts\"",
    "start": "bun --env-file=.env src/main.ts",
    "start:dev": "bun --watch --env-file=.env src/main.ts",
    "start:debug": "bun --watch --inspect --env-file=.env src/main.ts",
    "start:prod": "node dist/main",
    "lint": "prettier --write \"src/**/*.{ts,tsx}\" && oxlint src/ --fix",
    "email:dev": "email dev -d src/mailer/emails -p 3112",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.4",
    "@mikro-orm/core": "^7.2.1",
    "@mikro-orm/decorators": "^7.2.1",
    "@mikro-orm/mariadb": "^7.2.1",
    "@mikro-orm/migrations": "^7.2.1",
    "@mikro-orm/mysql": "^7.2.1",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.1",
    "@mikro-orm/reflection": "^7.2.1",
    "@mikro-orm/seeder": "^7.2.1",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.0",
    "@scalar/nestjs-api-reference": "^1.2.21",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.9.5",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.28.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@mikro-orm/cli": "^7.2.1",
    "@nestjs/cli": "^12.0.6",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@react-email/ui": "6.9.5",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prettier": "^3.9.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.5",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
